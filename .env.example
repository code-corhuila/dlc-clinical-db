# Contract consumed by clinical-db-migrate. Environment values are owned by dlc-infra-mongo.
MONGO_HOST=
MONGO_PORT=27017
CLINICAL_DB_NAME=clinical
MONGO_REPLICA_SET=rs0
PLATFORM_NETWORK_NAME=platform
# Authenticated runs (deploy/compose.auth.yml): identity and password file supplied by dlc-infra-mongo.
MONGO_MIGRATOR_USER=clinical_migrator
MONGO_MIGRATOR_PASSWORD_FILE=
