# Local tooling contract of clinical-db-migrate (deploy/compose.yml alone, unauthenticated, synthetic data).
# Stage deployments (dev, qa, prod) use env/.env.<stage>.example instead; values come from dlc-infra-mongo.
MONGO_HOST=
MONGO_PORT=27017
CLINICAL_DB_NAME=clinical
MONGO_REPLICA_SET=rs0
# MongoDB is reachable only on this network (dlc-infra-mongo). PLATFORM_NETWORK_NAME is still accepted.
CLINICAL_DATA_NETWORK_NAME=clinical-data
