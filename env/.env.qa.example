# qa stage, the qa branch (dlc-infra-mongo env/.env.qa.example). Not deployed yet: hosting is pending P-01.
# Never put a secret value here. Each *_FILE points to a file materialized from the stage secret store;
# the references are names only and their bindings are pending until the stage exists.
DLC_ENVIRONMENT=qa
MONGO_HOST=dlc-mongo
MONGO_PORT=27017
MONGO_REPLICA_SET=rs0
CLINICAL_DATA_NETWORK_NAME=clinical-data
MONGO_MIGRATOR_PASSWORD_FILE=/run/dlc-secrets/clinical-migrator-password   # ref: dlc/qa/clinical-mongo/migrator-password
# TLS is required in this stage: run with deploy/compose.tls.yml.
MONGO_TLS_CA_FILE=/run/dlc-secrets/mongo-tls-ca.pem                        # ref: dlc/qa/clinical-mongo/tls-ca
