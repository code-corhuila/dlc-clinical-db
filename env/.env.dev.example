# dev stage, the develop branch (dlc-infra-mongo env/.env.develop.example). Not deployed yet: hosting is pending P-01.
# Never put a secret value here. Each *_FILE points to a file materialized from the stage secret store;
# the references are names only. Synthetic data only.
DLC_ENVIRONMENT=dev
MONGO_HOST=dlc-mongo
MONGO_PORT=27017
MONGO_REPLICA_SET=rs0
CLINICAL_DATA_NETWORK_NAME=clinical-data
MONGO_MIGRATOR_PASSWORD_FILE=/run/dlc-secrets/clinical-migrator-password   # ref: dlc/develop/clinical-mongo/migrator-password
# TLS is optional in dev. To use it, add deploy/compose.tls.yml and set the CA file.
# MONGO_TLS_CA_FILE=/run/dlc-secrets/mongo-tls-ca.pem                      # ref: dlc/develop/clinical-mongo/tls-ca
